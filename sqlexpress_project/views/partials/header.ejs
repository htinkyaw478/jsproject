<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <title>
    <%= title || "Home" %>
  </title>
</head>

<body>
  <nav class="navbar navbar-expand-lg bg-body-tertiary py-3 px-3">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Blog</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
          <form action="/posts/search" method="GET" class="d-flex me-2">
            <input type="text" name="q" class="form-control" placeholder="Search Posts..">
            <button class="btn btn-primary">Search</button>
          </form>
          </li>
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/">Home</a>
          </li>
          <!-- <li class="nav-item">
            <a class="nav-link" href="/users">Users</a>
          </li> -->
          <!-- <li class="nav-item">
            <a class="nav-link" href="/posts">Post</a>
          </li> -->
          <%if(!isLoggedIn){%>
            <li class="nav-item">
              <a class="nav-link" href="/users/login">Login</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/users/register">Register</a>
            </li>
            <%}else{%>
              <li class="nav-item">
              <a class="btn btn-primary text-white" href="/posts/create">Create Post</a>
            </li>
            <li class="nav-item">
            <a class="nav-link" href="/posts">Post</a>
          </li>
              <li class="nav-item">
                <a class="nav-link" href="/users/profile/<%=userId%>">
                  <%=userName%>
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/users/logout">Logout</a>
              </li>
              <%}%>
        </ul>
      </div>
    </div>
  </nav>
  <img src="/uploads/back2.jpg" alt="hello" style="width: 100%; height: 30vh; object-fit: cover" />
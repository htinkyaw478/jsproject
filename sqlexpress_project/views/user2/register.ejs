<%- include('../partials/header', { title: 'Register' }) %>
  <form action="/users/register" method="POST" class="w-50 p-5 mt-5 shadow m-auto">

    <% if (message) { %>
      <p class="text-danger text-center bg-danger-subtle p-2 rounded">
        <%= message %>
      </p>
      <% } %>
        <h2>Register</h2>
        <div class="mb-3">
          <input type="text" name="name" value="<%= locals.old ? old.name || '' : '' %>" placeholder="Name..."
            class="form-control" />
        </div>
        <div class="mb-3">
          <input type="email" name="email" value="<%= locals.old ? old.email || '' : '' %>" placeholder="Email..."
            class="form-control" />
        </div>
        <div class="mb-3">
          <input type="password" name="password" placeholder="Password..." class="form-control"
            value="<%= locals.old ? old.password || '' : '' %>" />
        </div>
        <button type="submit" class="btn btn-primary">Register</button>
  </form>
  <%- include('../partials/footer') %>
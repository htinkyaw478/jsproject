<%- include('../partials/header') %>
  <form action="/users/login" method="POST" class="w-50 p-5 mt-5 shadow m-auto">
    <% if (message) { %>
      <p class="text-danger text-center bg-danger-subtle p-2 rounded">
        <%= message %>
      </p>
      <% } %>
        <h2>Login</h2>
        <div class="mb-3">
          <input type="email" name="email" value="<%= locals.old ? old.email || '' : '' %>" placeholder="Email..."
            class="form-control" />
        </div>
        <div class="mb-3">
          <input type="password" name="password" value="<%= locals.old ? old.password || '' : '' %>"
            placeholder="Password..." class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Login</button>
  </form>
  <%- include('../partials/footer') %>
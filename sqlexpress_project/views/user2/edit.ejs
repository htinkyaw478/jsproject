<%- include('../partials/header') %>
  <div class="p-5 text-center">
    <p class="text-danger">
      <%= message ? message : "" %>
    </p>
  </div>
  <% if (user !=null) { %>
    <form action="/users/update/<%= user.id %>" method="POST" class="w-50 p-5 mt-5 shadow m-auto">
      <h2>Edit User</h2>
      <div class="mb-3">
        <input type="name" name="name" value="<%= user.name %>" placeholder="name..." class="form-control" required />
      </div>
      <div class="mb-3">
        <input type="email" name="email" value="<%= user.email %>" placeholder="Email..." class="form-control"
          required />
      </div>

      <button type="submit" class="btn btn-primary">Update</button>
    </form>
    <%}%>
      <%- include('../partials/footer') %>
<%- include('../partials/header') %>
  <form action="/posts/update/<%= post.id %>" method="POST" enctype="multipart/form-data"
    class="w-50 m-auto p-5 shadow mt-5">
    <h2>Edit Post</h2>

    <input type="hidden" name="user_id" value="<%= post.user_id %>">
    <div class="mb-3">
      <label for="title">Title:</label>
      <input type="text" name="title" value="<%= post.title %>" required class="form-control">
    </div>

    <div class="mb-3">
      <label for="content">Content:</label>
      <textarea name="content" required class="form-control"><%= post.content %></textarea>
    </div>

    <div class="mb-3">
      <label for="photo">Photo:</label>
      <% if (post.photo) { %>
        <div>
          <img src="/uploads/<%= post.photo %>" alt="Post Photo" style="max-width: 50%; height: auto;">
        </div>
        <small>Current Photo</small>
        <% } %>
          <input type="file" class="form-control" name="photo" accept="image/*">
          <input type="hidden" name="oldPhoto" value="<%= post.photo %>">
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
  </form>
<%- include('../partials/footer') %>
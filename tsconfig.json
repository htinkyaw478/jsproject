{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "generic/**/*.ts",
    "abstract/**/*.ts",
    "abstract2/**/*.ts",
    "typescript/**/*.ts"
  ]
}
